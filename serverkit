#!/bin/sh
# serverkit launcher — POSIX sh on purpose: it must start anywhere, then hand
# over to bash >= 4.4 (macOS ships 3.2, so there it comes from Homebrew).
set -eu

# Resolve our real location through symlinks (e.g. ~/.local/bin/serverkit).
self=$0
while [ -L "$self" ]; do
  link=$(readlink "$self")
  case $link in /*) self=$link ;; *) self=$(dirname "$self")/$link ;; esac
done
SK_ROOT=$(cd "$(dirname "$self")" && pwd)

bash_ok() { # path -> true if bash >= 4.4
  [ -x "$1" ] || return 1
  "$1" -c '[ "${BASH_VERSINFO[0]}" -gt 4 ] || { [ "${BASH_VERSINFO[0]}" -eq 4 ] && [ "${BASH_VERSINFO[1]}" -ge 4 ]; }' 2>/dev/null
}

for b in "$(command -v bash 2>/dev/null || true)" /opt/homebrew/bin/bash /usr/local/bin/bash \
  /home/linuxbrew/.linuxbrew/bin/bash /bin/bash /usr/bin/bash; do
  if [ -n "$b" ] && bash_ok "$b"; then
    exec "$b" "$SK_ROOT/lib/run.bash" "$@"
  fi
done

# No suitable bash.
if [ "$(uname -s)" = Darwin ]; then
  echo "serverkit needs bash 4.4 or newer; macOS includes only 3.2."
  brew=""
  for p in /opt/homebrew/bin/brew /usr/local/bin/brew; do [ -x "$p" ] && brew=$p; done
  if [ -z "$brew" ]; then
    echo "It installs everything on macOS with Homebrew (https://brew.sh), which isn't installed yet."
    if [ -t 0 ]; then
      printf 'Install Homebrew now using its official installer? [Y/n] '
      read -r ans
      case $ans in [Nn]*) exit 1 ;; esac
      tmp=$(mktemp)
      curl --proto '=https' --tlsv1.2 -fsSL -o "$tmp" https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh
      /bin/bash "$tmp" </dev/tty
      rm -f "$tmp"
      for p in /opt/homebrew/bin/brew /usr/local/bin/brew; do [ -x "$p" ] && brew=$p; done
    fi
    [ -n "$brew" ] || { echo "Install Homebrew from https://brew.sh, then run serverkit again."; exit 1; }
  fi
  echo "Installing bash with Homebrew…"
  "$brew" install bash
  exec "$("$brew" --prefix)/bin/bash" "$SK_ROOT/lib/run.bash" "$@"
fi

echo "serverkit needs bash 4.4 or newer. Install it with your package manager (e.g. apk add bash), then try again." >&2
exit 1
