# managed-by:serverkit — sourced from ~/.zshrc. Put your own settings in
# ~/.zshrc itself (after the serverkit block); serverkit never edits them.
# Every integration is guarded: a missing tool means silence, not errors.

# ---------- PATH ----------
if [[ -z $HOMEBREW_PREFIX ]]; then
  for _b in /opt/homebrew/bin/brew /usr/local/bin/brew /home/linuxbrew/.linuxbrew/bin/brew "$HOME/.linuxbrew/bin/brew"; do
    [[ -x $_b ]] && { eval "$("$_b" shellenv)"; break; }
  done
  unset _b
fi
typeset -U path PATH
path=("$HOME/.local/bin" "$HOME/.cargo/bin" $path)
export EDITOR=${EDITOR:-$(command -v nvim || command -v vim || echo vi)}
export VISUAL=$EDITOR
export LESS='-R -F -X'

# ---------- SSH auto-tmux + banner (serverkit item: ssh-autotmux) ----------
# Early, so tmux takes over before the slower setup below runs.
[[ -f $HOME/.config/serverkit/login.zsh ]] && . "$HOME/.config/serverkit/login.zsh"

# ---------- history ----------
HISTFILE=${HISTFILE:-$HOME/.zsh_history}
HISTSIZE=200000
SAVEHIST=200000
setopt SHARE_HISTORY HIST_IGNORE_ALL_DUPS HIST_REDUCE_BLANKS EXTENDED_HISTORY
setopt AUTO_CD AUTO_PUSHD PUSHD_IGNORE_DUPS INTERACTIVE_COMMENTS

# ---------- completion ----------
if [[ -n $HOMEBREW_PREFIX ]]; then
  fpath=("$HOMEBREW_PREFIX/share/zsh-completions" "$HOMEBREW_PREFIX/share/zsh/site-functions" $fpath)
fi
autoload -Uz compinit && compinit -u
zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}'

# ---------- keys ----------
bindkey -e
bindkey '^[[A' history-search-backward
bindkey '^[[B' history-search-forward
bindkey '^[[1;5C' forward-word
bindkey '^[[1;5D' backward-word

# ---------- integrations ----------
if command -v starship >/dev/null; then eval "$(starship init zsh)"
else PROMPT='%F{cyan}%n@%m%f %F{yellow}%~%f %# '; fi
command -v zoxide >/dev/null && eval "$(zoxide init zsh)"
command -v direnv >/dev/null && eval "$(direnv hook zsh)"
command -v atuin  >/dev/null && eval "$(atuin init zsh --disable-up-arrow)"
[[ -z $MISE_SHELL ]] && command -v mise >/dev/null && eval "$(mise activate zsh)"
command -v fzf >/dev/null && source <(fzf --zsh 2>/dev/null)

# ---------- aliases: additive only; core commands keep their behaviour ----------
if command -v eza >/dev/null; then
  alias ls='eza --group-directories-first'
  alias ll='eza -lah --git --group-directories-first'
  alias lt='eza --tree --level=2'
fi
command -v bat        >/dev/null && alias catp='bat --style=plain'
command -v lazygit    >/dev/null && alias lg='lazygit'
command -v lazydocker >/dev/null && alias lzd='lazydocker'
command -v kubectl    >/dev/null && alias k='kubectl'
command -v nvim       >/dev/null && alias vi='nvim'
command -v docker     >/dev/null && alias dc='docker compose'
alias gs='git status -sb'
alias ..='cd ..'
alias ...='cd ../..'

# ---------- plugins (syntax highlighting must load last) ----------
if [[ -n $HOMEBREW_PREFIX ]]; then
  [[ -f $HOMEBREW_PREFIX/share/zsh-autosuggestions/zsh-autosuggestions.zsh ]] &&
    . "$HOMEBREW_PREFIX/share/zsh-autosuggestions/zsh-autosuggestions.zsh"
  [[ -f $HOMEBREW_PREFIX/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh ]] &&
    . "$HOMEBREW_PREFIX/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
fi
